{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/NetStream.Server/NetStream.Server.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "api tests",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/NetStream.Api.Tests/NetStream.Api.Tests.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ],
    "options": {
        "env": {
            "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
        }
    }
}
